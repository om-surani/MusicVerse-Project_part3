<%- include('partials/header') %>

<a href="/search" class="back-link">&larr; New search</a>

<h1>Results for "<%= keyword %>"</h1>
<p class="result-count"><%= results.length %> track<%= results.length === 1 ? '' : 's' %> found</p>

<div class="track-grid">
  <% results.forEach(track => { %>
    <a class="track-card" href="/items/<%= track.id %>">
      <img class="track-cover" src="<%= track.cover %>" alt="<%= track.genre %> cover art" />
      <span class="genre-tag"><%= track.genre %></span>
      <h3><%= track.track_name %></h3>
      <p class="artist"><%= track.artist_name %></p>
      <div class="track-meta">
        <span>⭐ <%= track.popularity %></span>
        <span>💃 <%= track.audioFeatures.danceability %></span>
      </div>
    </a>
  <% }) %>
</div>

<% if (results.length === 0) { %>
  <p class="empty-state">No tracks matched your search. Try a different keyword.</p>
<% } %>

<%- include('partials/footer') %>
